        {
          "datasource": { "type": "influxdb", "uid": "influx-meshtastic" },
          "query": "perType =\n  from(bucket: \"meshtastic_sim\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._measurement == \"packet_ota_tx\")\n    |> filter(fn: (r) => r.scenario_id =~ /${scenario_id:regex}/)\n    |> filter(fn: (r) => r.experiment_id =~ /${experiment_id:regex}/)\n    |> filter(fn: (r) => r._field == \"packet_id\")\n    |> group(columns: [\"portnum\"])\n    |> count()\n    |> rename(columns: {_value: \"liczba\"})\n\ntotal = perType |> sum(column: \"liczba\") |> findRecord(fn: (key) => true, idx: 0)\n\nperType\n  |> map(fn: (r) => ({\n      portnum: r.portnum,\n      liczba: r.liczba,\n      udzial_proc: if exists v: total._value and total._value > 0 then float(v: r.liczba) / float(v: total._value) * 100.0 else 0.0,\n    }))\n  |> sort(columns: [\"liczba\"], desc: true)",
          "refId": "A"
        }
      ],
