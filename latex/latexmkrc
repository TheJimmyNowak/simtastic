# latexmk: `latexmk` (jednorazowo), `latexmk -pvc` (podgląd na żywo), `latexmk -c` (sprzątanie)
@default_files = ('Praca_inzynierska.tex');   # zmień, jeśli plik główny nazywa się inaczej

# Silnik: 1 = pdfLaTeX (domyślny w Overleaf), 4 = LuaLaTeX, 5 = XeLaTeX
$pdf_mode = 1;
$pdflatex = 'pdflatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';
$lualatex = 'lualatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';
$xelatex  = 'xelatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';

$out_dir = 'build';
$bibtex_use = 2;                 # bibtex/biber uruchamiane automatycznie, gdy są potrzebne
$pdf_previewer = 'xdg-open %S';
